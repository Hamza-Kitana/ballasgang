# Site URL (SEO) — without trailing slash
VITE_SITE_URL=https://www.ballasgang.site

# Admin dashboard password (required)
ADMIN_PASSWORD=change-me-strong-password

# Session encryption secret (min 32 chars)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret-32chars

# JSONBin.io — Master Key from https://jsonbin.io/app/api-keys
JSONBIN_MASTER_KEY=

# Bin ID from: bun run seed:jsonbin
JSONBIN_BIN_ID=
